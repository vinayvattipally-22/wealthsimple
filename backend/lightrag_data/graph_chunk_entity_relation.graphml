    <node id="$400">
      <data key="d0">$400</data>
      <data key="d1">data</data>
      <data key="d2">The amount of up to $400 per year is available for eligible renters through the BC Renter's Tax Credit.</data>
      <data key="d3">chunk-ac4a966efafa608e325e5ad271e6360c</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1772370076</data>
      <data key="d6" />
