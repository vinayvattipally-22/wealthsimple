    <node id="Nova Scotia Basic Personal Amount">
      <data key="d0">Nova Scotia Basic Personal Amount</data>
      <data key="d1">concept</data>
      <data key="d2">The Nova Scotia Basic Personal Amount refers to the personal income tax amount exempted from taxation, which is $8,481 from 2018 to 2024, with a slight increase in 2025.</data>
      <data key="d3">chunk-d21a44166a9353305cd81b62bee19bd3</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1772369994</data>
      <data key="d6" />
    </node>
    <node id="NS Affordable Living Tax Credit">
      <data key="d0">NS Affordable Living Tax Credit</data>
      <data key="d1">concept</data>
      <data key="d2">The NS Affordable Living Tax Credit is a benefit providing up to $255 per adult and $60 per child, aimed at supporting low-income residents, delivered quarterly alongside GST/HST credit.&lt;SEP&gt;The NS Affordable Living Tax Credit provides financial assistance to ease living costs for residents.</data>
      <data key="d3">chunk-d21a44166a9353305cd81b62bee19bd3&lt;SEP&gt;chunk-6e6767fe1983997e5594e2d1e81f3962</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1772370167</data>
      <data key="d6" />
    </node>
    <node id="NS Poverty Reduction Credit">
      <data key="d0">NS Poverty Reduction Credit</data>
      <data key="d1">concept</data>
      <data key="d2">The NS Poverty Reduction Credit offers $250 per adult and $62.50 per child to assist low-income individuals and families in Nova Scotia.&lt;SEP&gt;The NS Poverty Reduction Credit provides financial assistance to low-income residents in Nova Scotia.&lt;SEP&gt;The NS Poverty Reduction Credit aims to support low-income families and individuals in Nova Scotia.</data>
      <data key="d3">chunk-d21a44166a9353305cd81b62bee19bd3&lt;SEP&gt;chunk-6e6767fe1983997e5594e2d1e81f3962&lt;SEP&gt;chunk-11c553d9c05dddfa3309447cb2baa12c</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1772370167</data>
      <data key="d6" />
    </node>
    <node id="NS Graduate Scholarship">
      <data key="d0">NS Graduate Scholarship</data>
      <data key="d1">concept</data>
      <data key="d2">The NS Graduate Scholarship provides a 50% reduction in tuition for graduates who reside and work in Nova Scotia, encouraging local employment.&lt;SEP&gt;The NS Graduate Scholarship offers a 50% tuition reduction for graduates residing or working in Nova Scotia.</data>
      <data key="d3">chunk-d21a44166a9353305cd81b62bee19bd3&lt;SEP&gt;chunk-11c553d9c05dddfa3309447cb2baa12c</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1772370169</data>
