    <node id="Taxable Allowances">
      <data key="d0">Taxable Allowances</data>
      <data key="d1">concept</data>
      <data key="d2">Taxable Allowances are benefits provided by employers that must be reported as income on the T4 Slip.</data>
      <data key="d3">chunk-f7c5cf2323ead79ef1bb328c9701238d</data>
