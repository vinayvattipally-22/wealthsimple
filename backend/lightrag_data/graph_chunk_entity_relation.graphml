    <node id="Tax Year 2024">
      <data key="d0">Tax Year 2024</data>
      <data key="d1">event</data>
      <data key="d2">The Tax Year 2024 refers to the fiscal year for which the reported income and deductions are calculated and filed.&lt;SEP&gt;Tax Year 2024 refers to the year for which the RRSP maximum new room limit was set at $31,560.</data>
      <data key="d3">chunk-f7c5cf2323ead79ef1bb328c9701238d&lt;SEP&gt;chunk-1590b8716306682b296c39fb8f8a1c64</data>
