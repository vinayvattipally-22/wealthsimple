    <node id="EI Premiums">
      <data key="d0">EI Premiums</data>
      <data key="d1">concept</data>
      <data key="d2">EI Premiums are amounts deducted from an employee's salary for Employment Insurance and reported on the T4 Slip.</data>
      <data key="d3">chunk-f7c5cf2323ead79ef1bb328c9701238d</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1772101186</data>
      <data key="d6" />
