      <data key="d0">Old Age Security (OAS)</data>
      <data key="d3">chunk-4efa231cfe20987fec08d6db7e701fb2</data>
      <data key="d2">The rules of the Tax-Free Savings Account impact beneficiaries' eligibility for Old Age Security benefits.</data>
      <data key="d1">UNKNOWN</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1772101408</data>
      <data key="d6" />
