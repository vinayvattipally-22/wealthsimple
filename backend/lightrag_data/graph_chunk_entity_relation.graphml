    <node id="Quebec Pension Plan (QPP)">
      <data key="d0">Quebec Pension Plan (QPP)</data>
      <data key="d1">concept</data>
      <data key="d2">The Quebec Pension Plan (QPP) is a pension plan available to Quebec residents that offers retirement benefits, with slightly higher rates than CPP.</data>
      <data key="d3">chunk-a149e8a923d92f6e23bd59e44524fceb</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1772101146</data>
      <data key="d6" />
    </node>
    <node id="Employment Insurance (EI)">
      <data key="d0">Employment Insurance (EI)</data>
      <data key="d1">concept</data>
      <data key="d2">Employment Insurance (EI) provides temporary financial assistance to unemployed individuals in Canada.</data>
      <data key="d3">chunk-a149e8a923d92f6e23bd59e44524fceb</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1772101147</data>
