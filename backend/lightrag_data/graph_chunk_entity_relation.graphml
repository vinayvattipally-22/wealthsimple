    <node id="$60,000">
      <data key="d0">$60,000</data>
      <data key="d1">data</data>
      <data key="d2">The income threshold of $60,000 is the limit above which the BC Renter's Tax Credit begins to reduce.</data>
      <data key="d3">chunk-ac4a966efafa608e325e5ad271e6360c</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1772370076</data>
