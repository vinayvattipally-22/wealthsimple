      <data key="d0">$1,000</data>
      <data key="d1">data</data>
      <data key="d2">The basic amount of $1,000 per year is provided by the BC Training Tax Credit during the training period.</data>
      <data key="d3">chunk-ac4a966efafa608e325e5ad271e6360c</data>
      <data key="d4">unknown_source</data>
