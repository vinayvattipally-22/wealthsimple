      <data key="d1">data</data>
      <data key="d2">The Social Insurance Number (SIN) is a unique identifier for individuals in Canada, necessary for opening a TFSA and other official purposes.</data>
      <data key="d3">chunk-4efa231cfe20987fec08d6db7e701fb2</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1772101398</data>
      <data key="d6" />
