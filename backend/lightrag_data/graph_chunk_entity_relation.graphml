    <node id="2016–2018 Contribution Limit">
      <data key="d0">2016–2018 Contribution Limit</data>
      <data key="d1">data</data>
      <data key="d2">The contribution limit for the TFSA from 2016 to 2018 was set at $5,500 per year.</data>
      <data key="d3">chunk-4efa231cfe20987fec08d6db7e701fb2</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1772101398</data>
      <data key="d6" />
    </node>
    <node id="2019–2022 Contribution Limit">
      <data key="d0">2019–2022 Contribution Limit</data>
      <data key="d1">data</data>
      <data key="d2">The contribution limit for the TFSA from 2019 to 2022 was set at $6,000 per year.</data>
      <data key="d3">chunk-4efa231cfe20987fec08d6db7e701fb2</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1772101400</data>
