    </node>
    <node id="Ontario Health Premium">
      <data key="d0">Ontario Health Premium</data>
      <data key="d1">concept</data>
      <data key="d2">The Ontario Health Premium is a levy based on taxable income collected alongside income tax, varying by income brackets.&lt;SEP&gt;The Ontario Health Premium is a levy collected alongside income tax, varying based on taxable income.</data>
      <data key="d3">chunk-0c7bba92e1e9b7a1972810e69c85c424&lt;SEP&gt;chunk-6e6767fe1983997e5594e2d1e81f3962</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1772370164</data>
      <data key="d6" />
    </node>
    <node id="Ontario Sales Tax Credit (OSTC)">
      <data key="d0">Ontario Sales Tax Credit (OSTC)</data>
      <data key="d1">concept</data>
      <data key="d2">The Ontario Sales Tax Credit (OSTC) provides financial assistance up to $345 per adult and child, adjusted by family income.</data>
      <data key="d3">chunk-0c7bba92e1e9b7a1972810e69c85c424</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1772101289</data>
      <data key="d6" />
    </node>
    <node id="Qualifying Rollover Recipients">
      <data key="d0">Qualifying Rollover Recipients</data>
      <data key="d1">concept</data>
      <data key="d2">Qualifying rollover recipients include specific individuals such as a spouse, common-law partner, and financially dependent children or grandchildren.</data>
      <data key="d3">chunk-74f42f89274db1c03e3ad487f53119a4</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1772101327</data>
      <data key="d6" />
    </node>
    <node id="Spousal RRSPs">
      <data key="d0">Spousal RRSPs</data>
      <data key="d1">concept</data>
      <data key="d2">Spousal RRSPs are retirement savings plans used for income splitting between partners.</data>
      <data key="d3">chunk-74f42f89274db1c03e3ad487f53119a4</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1772101327</data>
      <data key="d6" />
