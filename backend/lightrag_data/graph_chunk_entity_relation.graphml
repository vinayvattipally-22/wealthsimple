      <data key="d6" />
    </node>
    <node id="Box 24">
      <data key="d0">Box 24</data>
      <data key="d1">data</data>
      <data key="d2">Box 24 is referenced alongside Box 14 and is subject to caps in the financial context.&lt;SEP&gt;Box 24 is utilized for reporting EI contributions on T4 slips.</data>
      <data key="d3">chunk-be3c8254ac3b81df856eab05e2babc4e&lt;SEP&gt;chunk-041dc2e0b32226e0b7c758a7359523f3</data>
