      <data key="d6" />
    </node>
    <node id="BC Training Tax Credit">
      <data key="d0">BC Training Tax Credit</data>
      <data key="d1">concept</data>
      <data key="d2">The BC Training Tax Credit is a refundable credit for apprentices, offering $1,000 per year during training and $2,500 for completion in Red Seal trades.&lt;SEP&gt;The BC Training Tax Credit provides annual financial support for apprentices and certified tradespeople completing their training.</data>
      <data key="d3">chunk-ac4a966efafa608e325e5ad271e6360c&lt;SEP&gt;chunk-6e6767fe1983997e5594e2d1e81f3962</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1772370165</data>
      <data key="d6" />
    </node>
    <node id="BC Home Owner Grant">
      <data key="d0">BC Home Owner Grant</data>
      <data key="d1">concept</data>
      <data key="d2">The BC Home Owner Grant reduces property taxes up to $770 for basic qualifications and $1,045 for seniors or disabled individuals.&lt;SEP&gt;The BC Home Owner Grant provides property tax reductions for homeowners in British Columbia.</data>
      <data key="d3">chunk-ac4a966efafa608e325e5ad271e6360c&lt;SEP&gt;chunk-6e6767fe1983997e5594e2d1e81f3962</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1772370165</data>
      <data key="d6" />
    </node>
    <node id="BC Medical Services Plan">
      <data key="d0">BC Medical Services Plan</data>
      <data key="d1">concept</data>
      <data key="d2">The BC Medical Services Plan (MSP) eliminated health premiums as of January 1, 2020, meaning no health premium is charged in BC.</data>
      <data key="d3">chunk-ac4a966efafa608e325e5ad271e6360c</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1772370074</data>
      <data key="d6" />
    </node>
