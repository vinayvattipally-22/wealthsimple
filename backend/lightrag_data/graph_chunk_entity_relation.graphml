    <node id="RPP Contributions">
      <data key="d0">RPP Contributions</data>
      <data key="d1">concept</data>
      <data key="d2">RPP Contributions are amounts employees contribute to Registered Pension Plans and can be deducted from taxable income.</data>
      <data key="d3">chunk-f7c5cf2323ead79ef1bb328c9701238d</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1772101187</data>
