      <data key="d0">BC Basic Personal Amount</data>
      <data key="d1">data</data>
      <data key="d2">The BC Basic Personal Amount represents the non-taxable portion of income that individuals can earn before paying provincial income tax, with values specified for the years 2021 to 2025.</data>
      <data key="d3">chunk-deb12f259747bd99535c1890ffca3b60</data>
      <data key="d4">unknown_source</data>
