    </node>
    <node id="NS Volunteer Firefighter/SAR Tax Credit">
      <data key="d0">NS Volunteer Firefighter/SAR Tax Credit</data>
      <data key="d1">concept</data>
      <data key="d2">The NS Volunteer Firefighter Tax Credit is a non-refundable credit worth $500, provided to volunteer firefighters in Nova Scotia.</data>
