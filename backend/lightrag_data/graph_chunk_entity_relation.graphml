      <data key="d0">BC BPA Credit</data>
      <data key="d1">concept</data>
      <data key="d2">BC BPA credit is a tax credit calculated based on the BC Basic Personal Amount and offered to reduce the taxable income.</data>
      <data key="d3">chunk-deb12f259747bd99535c1890ffca3b60</data>
      <data key="d4">unknown_source</data>
