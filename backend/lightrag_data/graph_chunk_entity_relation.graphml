    <node id="RRSP Deductions">
      <data key="d0">RRSP Deductions</data>
      <data key="d1">concept</data>
      <data key="d2">RRSP deductions are contributions made to Registered Retirement Savings Plans used to reduce taxable income.</data>
      <data key="d3">chunk-041dc2e0b32226e0b7c758a7359523f3</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1772101189</data>
