    <node id="Union Dues">
      <data key="d0">Union Dues</data>
      <data key="d1">concept</data>
      <data key="d2">Union Dues are fees paid by employees to their unions, which can be deducted from gross income.</data>
      <data key="d3">chunk-f7c5cf2323ead79ef1bb328c9701238d</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1772101188</data>
