    <node id="CPP Contributions">
      <data key="d0">CPP Contributions</data>
      <data key="d1">concept</data>
      <data key="d2">CPP Contributions are employee contributions to the Canada Pension Plan, reported on T4 slips for tax purposes.</data>
      <data key="d3">chunk-f7c5cf2323ead79ef1bb328c9701238d</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1772101186</data>
      <data key="d6" />
