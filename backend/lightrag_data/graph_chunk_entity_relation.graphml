    <node id="Ontario Tax Guide">
      <data key="d0">Ontario Tax Guide</data>
      <data key="d1">document</data>
      <data key="d2">The Ontario Tax Guide provides comprehensive information about tax obligations, rates, and credits applicable to residents of Ontario.</data>
      <data key="d3">chunk-af3ccb564fd9b7b3591223bd47140183</data>
      <data key="d4">unknown_source</data>
