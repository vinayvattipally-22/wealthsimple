      <data key="d0">$41,071</data>
      <data key="d1">data</data>
      <data key="d2">The income threshold of $41,071 is specified for individuals to qualify for certain tax credits.</data>
      <data key="d3">chunk-ac4a966efafa608e325e5ad271e6360c</data>
