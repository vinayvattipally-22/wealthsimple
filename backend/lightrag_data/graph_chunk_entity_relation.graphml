    <node id="Multiple T4 Slips">
      <data key="d0">Multiple T4 Slips</data>
      <data key="d1">concept</data>
      <data key="d2">Multiple T4 Slips occur when an employee has worked for multiple employers in a tax year, requiring consolidation on the T1 return.</data>
      <data key="d3">chunk-f7c5cf2323ead79ef1bb328c9701238d</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1772101188</data>
