      <data key="d0">Tax Brackets</data>
      <data key="d1">concept</data>
      <data key="d2">Tax brackets represent the ranges of taxable income and the corresponding tax rates for individuals in New Brunswick and Nova Scotia for various tax years.</data>
      <data key="d3">chunk-fe8637be3ac5b554a9bb36bec631101a</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1772369992</data>
      <data key="d6" />
    </node>
    <node id="NB Low-Income Tax Reduction">
      <data key="d0">NB Low-Income Tax Reduction</data>
      <data key="d1">concept</data>
      <data key="d2">The NB Low-Income Tax Reduction is a tax benefit for individuals with income below a specified threshold in New Brunswick.&lt;SEP&gt;The NB Low-Income Tax Reduction is a tax relief measure for individuals with low net income in New Brunswick.</data>
      <data key="d3">chunk-fe8637be3ac5b554a9bb36bec631101a&lt;SEP&gt;chunk-6e6767fe1983997e5594e2d1e81f3962</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1772370167</data>
      <data key="d6" />
    </node>
    <node id="NB Seniors' Home Renovation Tax Credit">
      <data key="d0">NB Seniors' Home Renovation Tax Credit</data>
      <data key="d1">concept</data>
      <data key="d2">The NB Seniors' Home Renovation Tax Credit provides a refundable credit based on eligible renovation costs for seniors in New Brunswick.</data>
      <data key="d3">chunk-fe8637be3ac5b554a9bb36bec631101a</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1772369992</data>
      <data key="d6" />
    </node>
    <node id="NB Child Tax Benefit">
      <data key="d0">NB Child Tax Benefit</data>
      <data key="d1">concept</data>
      <data key="d2">The NB Child Tax Benefit is a financial benefit for families with children in New Brunswick, distributed quarterly.</data>
      <data key="d3">chunk-fe8637be3ac5b554a9bb36bec631101a</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1772369993</data>
      <data key="d6" />
    </node>
    <node id="HST">
      <data key="d0">HST</data>
      <data key="d1">concept</data>
      <data key="d2">HST is the Harmonized Sales Tax used in New Brunswick, combining federal and provincial tax rates.&lt;SEP&gt;HST in Newfoundland is a harmonized sales tax that combines federal and provincial rates.&lt;SEP&gt;HST refers to the Harmonized Sales Tax applied in Nova Scotia at a combined rate of 15%, comprising 5% federal and 10% provincial tax.</data>
      <data key="d3">chunk-fe8637be3ac5b554a9bb36bec631101a&lt;SEP&gt;chunk-d21a44166a9353305cd81b62bee19bd3&lt;SEP&gt;chunk-bcc35deaf2234a3f8713639ffa324b31</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1772369994</data>
      <data key="d6" />
    </node>
    <node id="New Brunswick Provincial Income Tax">
      <data key="d0">New Brunswick Provincial Income Tax</data>
      <data key="d1">concept</data>
      <data key="d2">The New Brunswick Provincial Income Tax is the specific taxation system implemented in New Brunswick for individual income.</data>
      <data key="d3">chunk-fe8637be3ac5b554a9bb36bec631101a</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1772369994</data>
      <data key="d6" />
    </node>
    <node id="Nova Scotia Provincial Income Tax">
      <data key="d0">Nova Scotia Provincial Income Tax</data>
      <data key="d1">concept</data>
      <data key="d2">The Nova Scotia Provincial Income Tax is the taxation system in Nova Scotia related to individual income.</data>
      <data key="d3">chunk-fe8637be3ac5b554a9bb36bec631101a</data>
      <data key="d4">unknown_source</data>
