    <node id="T4 Slip">
      <data key="d0">T4 Slip</data>
      <data key="d1">content</data>
      <data key="d2">The T4 Slip is a document issued by employers to detail employment income and deductions for employees.</data>
      <data key="d3">chunk-f7c5cf2323ead79ef1bb328c9701238d</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1772101186</data>
      <data key="d6" />
    </node>
    <node id="T4 Box Reference Guide">
      <data key="d0">T4 Box Reference Guide</data>
      <data key="d1">content</data>
      <data key="d2">The T4 Box Reference Guide provides detailed information about various T4 boxes, including descriptions and tax treatments.</data>
      <data key="d3">chunk-f7c5cf2323ead79ef1bb328c9701238d</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1772101186</data>
      <data key="d6" />
    </node>
    <node id="Employment Income">
      <data key="d0">Employment Income</data>
      <data key="d1">concept</data>
      <data key="d2">Employment Income refers to money received by employees in exchange for their work, reported on the T4 Slip.</data>
      <data key="d3">chunk-f7c5cf2323ead79ef1bb328c9701238d</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1772101186</data>
      <data key="d6" />
