      <data key="d4">unknown_source</data>
      <data key="d5">1772101366</data>
      <data key="d6" />
    </node>
    <node id="Tax-Free Savings Account (TFSA)">
      <data key="d0">Tax-Free Savings Account (TFSA)</data>
      <data key="d1">concept</data>
      <data key="d2">The Tax-Free Savings Account (TFSA) is a registered savings account for Canadian residents, allowing tax-free income from investments, with specific rules for contributions and withdrawals.</data>
      <data key="d3">chunk-4efa231cfe20987fec08d6db7e701fb2</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1772101398</data>
      <data key="d6" />
    </node>
    <node id="CRA">
      <data key="d0">CRA</data>
      <data key="d1">organization</data>
      <data key="d2">The Canada Revenue Agency (CRA) is the governmental body responsible for tax collection and administration in Canada, providing guidelines for the TFSA.</data>
      <data key="d3">chunk-4efa231cfe20987fec08d6db7e701fb2</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1772101398</data>
      <data key="d6" />
    </node>
    <node id="Canadian Residents">
      <data key="d0">Canadian Residents</data>
      <data key="d1">concept</data>
      <data key="d2">Canadian residents are individuals who live in Canada and are eligible to open a Tax-Free Savings Account (TFSA) if they meet certain criteria.</data>
      <data key="d3">chunk-4efa231cfe20987fec08d6db7e701fb2</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1772101398</data>
