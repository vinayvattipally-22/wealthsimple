    <node id="Canada Pension Plan (CPP)">
      <data key="d0">Canada Pension Plan (CPP)</data>
      <data key="d1">concept</data>
      <data key="d2">The Canada Pension Plan (CPP) is a social insurance program in Canada that provides retirement pensions and benefits to contributors.</data>
      <data key="d3">chunk-a149e8a923d92f6e23bd59e44524fceb</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1772101146</data>
